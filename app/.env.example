# Marketing Dashboard API Configuration

# Server
PORT=3001
NODE_ENV=production

# Meta Ads API
META_ACCESS_TOKEN=your_meta_access_token_here
META_AD_ACCOUNT_ID=your_ad_account_id_here

# Buffer API (Social Media Scheduling)
